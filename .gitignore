.git-rewrite/
__pycache__/
*.pyc

# Runtime SQLite databases. These are per-deployment state, not source: when
# they were committed, every deploy overwrote whatever users had written with
# a stale local snapshot. Each module recreates its schema on startup, so an
# absent file is the normal cold-start case, not an error.
*.db
*.db-journal
*.db-wal
*.db-shm

# Signup capture: runtime data, and it holds email addresses. It was
# committed here, so every deploy overwrote the live list with the copy from
# git, in a public repository.
notify_signups.jsonl
release/miner/downloads/
*.tar.gz
*.zip
CURRENT_TUNNEL_URL.txt
