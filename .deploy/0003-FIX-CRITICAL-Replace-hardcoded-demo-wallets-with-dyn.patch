+        // Populate wallets screen with user's actual wallet (not demo data)
+        function populateWalletsScreen() {
+            const wallet = CustodialWallet.getWallet();
+            const container = document.getElementById('walletsContainer');
+            if (!container) return;
+
+            container.innerHTML = `
+                <div class="wallet-item">
+                    <div class="wallet-name">${wallet.walletName}</div>
+                    <div class="wallet-balance">${mbite(wallet.balanceCents)} MBITE</div>
+                    <div style="font-size: 11px; color: var(--text-secondary); margin-top: 4px;">
+                        ${wallet.address}
+                    </div>
+                </div>
+                <button class="btn btn-secondary" onclick="showScreen('dashboardScreen')" style="width: 100%; margin-top: var(--spacing-lg);">View Details →</button>
+            `;
+        }
