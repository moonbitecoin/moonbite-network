+// The guard logic still has to behave if a rate is ever supplied, so exercise
+// it with explicit local params rather than deleting the coverage entirely.
+BOOST_AUTO_TEST_CASE(treasury_guards_test)
+{
+    Consensus::Params params;
+    params.nSubsidyHalvingInterval = 330000;
+    params.nTreasuryRateBps = 500;
+    params.nTreasurySunsetHeight = 660000;
+
+    // An empty script disables the slice even when a rate is set - this is what
+    // keeps a misconfiguration from paying coins to nowhere.
+    params.treasuryScript.clear();
+    BOOST_CHECK_EQUAL(GetTreasuryAmount(1, params), CAmount{0});
+
+    // With a script present the split is exact, and conserves the subsidy.
+    params.treasuryScript = {0x00, 0x14};
+    const CAmount sub = GetBlockSubsidy(1, params);
+    const CAmount tre = GetTreasuryAmount(1, params);
+    BOOST_CHECK_EQUAL(sub, 50 * COIN);
+    BOOST_CHECK_EQUAL(tre, sub * 500 / 10000);
+    BOOST_CHECK_EQUAL(tre + (sub - tre), sub);
+
+    // Genesis pays nothing, and the sunset is hard.
+    BOOST_CHECK_EQUAL(GetTreasuryAmount(0, params), CAmount{0});
+    BOOST_CHECK_EQUAL(GetTreasuryAmount(660000, params), CAmount{0});
+    BOOST_CHECK_EQUAL(GetTreasuryAmount(660001, params), CAmount{0});
 }
 
