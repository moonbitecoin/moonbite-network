{
  "name": "MoonBite Wallet",
  "short_name": "MoonBite",
  "description": "Self-custody wallet for MBITE. Your keys never leave this device.",
  "start_url": "/wallet-app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#0B0D12",
  "background_color": "#0B0D12",
  "prefer_related_applications": false,
  "categories": ["finance"],
  "icons": [
    {
      "src": "/static/moonbite-logo.svg",
      "sizes": "192x192 512x512 any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Send MBITE",
      "short_name": "Send",
      "description": "Send MBITE to another wallet",
      "url": "/wallet-app?action=send",
      "icons": [
        { "src": "/static/moonbite-logo.svg", "sizes": "96x96 any", "type": "image/svg+xml" }
      ]
    },
    {
      "name": "Receive MBITE",
      "short_name": "Receive",
      "description": "Receive MBITE from another wallet",
      "url": "/wallet-app?action=receive",
      "icons": [
        { "src": "/static/moonbite-logo.svg", "sizes": "96x96 any", "type": "image/svg+xml" }
      ]
    },
    {
      "name": "My Wallets",
      "short_name": "Wallets",
      "description": "View and manage your wallets",
      "url": "/wallet-app?action=wallets",
      "icons": [
        { "src": "/static/moonbite-logo.svg", "sizes": "96x96 any", "type": "image/svg+xml" }
      ]
    }
  ],
  "share_target": {
    "action": "/wallet-app",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
