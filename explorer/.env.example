# MoonBite explorer environment variables (copy into Railway → Variables)

# --- Demo mode -------------------------------------------------------------
# Set to 1 to serve realistic sample data with NO chain backend (great for a
# first deploy / public demo). Set to 0 (or remove) to talk to a real node.
DEMO_MODE=1

# --- Real node connection (only needed when DEMO_MODE=0) -------------------
# Point these at a publicly reachable moonbited JSON-RPC endpoint.
MOONBITE_RPC_HOST=your.node.public.ip
MOONBITE_RPC_PORT=9445
MOONBITE_RPC_USER=changeme
MOONBITE_RPC_PASSWORD=changeme
MOONBITE_RPC_TIMEOUT=8

# --- Display ---------------------------------------------------------------
MOONBITE_NAME=MoonBite
MOONBITE_TICKER=MBITE
EXPLORER_LATEST_BLOCKS=15

# NOTE: Do NOT set EXPLORER_PORT on Railway. Railway injects $PORT and the
# start command binds gunicorn to it automatically.
